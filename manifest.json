{
  "manifest_version": 3,
  "name": "clim",
  "description": "日本語WebページをクリーンなMarkdown/Scrapbox/HTMLリンクとして素早くコピーします。",
  "version": "1.0.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "clim",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "copy-markdown-link": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "windows": "Alt+Shift+C",
        "linux": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "現在のページをMarkdownリンクとしてコピー"
    },
    "copy-markdown-frontmatter-link": {
      "description": "現在のページをfrontmatter付きMarkdownとしてコピー"
    },
    "copy-markdown-quote-link": {
      "description": "選択テキストを引用してMarkdownリンクとしてコピー"
    },
    "copy-scrapbox-link": {
      "description": "現在のページをScrapboxリンクとしてコピー"
    },
    "copy-plain-text-link": {
      "description": "現在のページをプレーンテキストとしてコピー"
    },
    "copy-html-link": {
      "description": "現在のページをHTMLリンクとしてコピー"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared-config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
