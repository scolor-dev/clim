{
  "manifest_version": 3,
  "name": "Clim - クリム",
  "description": "Clim はショートカットや右クリックから、テンプレートで整形したページ情報をコピーします。",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clim",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "commands": {
    "copy-slot-1": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "windows": "Alt+Shift+C",
        "linux": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Clim スロット1でコピー"
    },
    "copy-slot-2": {
      "description": "Clim スロット2でコピー"
    },
    "copy-slot-3": {
      "description": "Clim スロット3でコピー"
    },
    "copy-slot-4": {
      "description": "Clim スロット4でコピー"
    }
  }
}
