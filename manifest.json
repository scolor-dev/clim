{
  "manifest_version": 3,
  "name": "clim",
  "description": "タイトルとURLを複数形式でコピー。設定: chrome://extensions/shortcuts",
  "version": "0.3.2",
  "action": {
    "default_title": "clim"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "copy-markdown-link": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "windows": "Alt+Shift+C",
        "linux": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "現在のページをMarkdownリンクとしてコピー"
    },
    "copy-markdown-frontmatter-link": {
      "description": "現在のページをfrontmatter付きMarkdownとしてコピー"
    },
    "copy-scrapbox-link": {
      "description": "現在のページをScrapboxリンクとしてコピー"
    },
    "copy-plain-text-link": {
      "description": "現在のページをプレーンテキストとしてコピー"
    },
    "copy-html-link": {
      "description": "現在のページをHTMLリンクとしてコピー"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
